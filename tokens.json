{
  "$schema": "https://design-tokens.org/schemas/2024-09-tokens.json",
  "color": {
    "brand": {
      "primary": {
        "$type": "color",
        "$value": "#E61B25",
        "$description": "The Heart signature red."
      },
      "black": {
        "$type": "color",
        "$value": "#000000",
        "$description": "Primary text colour."
      },
      "green": {
        "$type": "color",
        "$value": "#13A538",
        "$description": "Positive / done signals."
      },
      "background": {
        "$type": "color",
        "$value": "#FFFFFF"
      }
    },
    "accent": {
      "blue": {
        "$type": "color",
        "$value": "#0056A4",
        "$description": "Use sparingly \u2014 accent if needed."
      },
      "red_light": {
        "$type": "color",
        "$value": "#E9787E"
      }
    },
    "neutral": {
      "gray_1": {
        "$type": "color",
        "$value": "#969696",
        "$description": "Secondary text, captions."
      },
      "gray_2": {
        "$type": "color",
        "$value": "#E6E6E6",
        "$description": "Borders, dividers."
      },
      "gray_3": {
        "$type": "color",
        "$value": "#F0F0F0",
        "$description": "Subtle surfaces, hover states."
      }
    },
    "status": {
      "done": {
        "$type": "color",
        "$value": "#13A538"
      },
      "in_progress": {
        "$type": "color",
        "$value": "#000000",
        "$description": "Status pill for active items \u2014 uses black instead of blue per brand rule (blue is an opt-in accent)."
      },
      "at_risk": {
        "$type": "color",
        "$value": "#E9787E"
      },
      "blocked": {
        "$type": "color",
        "$value": "#E61B25"
      },
      "planned": {
        "$type": "color",
        "$value": "#969696"
      }
    }
  },
  "font": {
    "family": {
      "heading": {
        "$type": "fontFamily",
        "$value": [
          "Raleway SemiBold"
        ]
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "Raleway"
        ]
      },
      "emphasis": {
        "$type": "fontFamily",
        "$value": [
          "Raleway SemiBold"
        ]
      },
      "light": {
        "$type": "fontFamily",
        "$value": [
          "Raleway Light"
        ]
      },
      "fallback": {
        "$type": "fontFamily",
        "$value": [
          "Arial"
        ]
      }
    },
    "size": {
      "title": {
        "$type": "number",
        "$value": 36
      },
      "h1": {
        "$type": "number",
        "$value": 28
      },
      "h2": {
        "$type": "number",
        "$value": 20
      },
      "section": {
        "$type": "number",
        "$value": 12
      },
      "body": {
        "$type": "number",
        "$value": 14
      },
      "supporting": {
        "$type": "number",
        "$value": 12
      },
      "caption": {
        "$type": "number",
        "$value": 10
      }
    }
  },
  "spacing": {
    "margin_h_pct": {
      "$type": "number",
      "$value": 8
    },
    "margin_v_pct": {
      "$type": "number",
      "$value": 8
    }
  }
}